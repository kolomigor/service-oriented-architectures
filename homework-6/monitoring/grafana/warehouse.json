{
  "uid": "warehouse",
  "title": "Warehouse",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Consumer lag by partition",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "consumer_lag{job=\"lag\"}",
          "legendFormat": "partition {{partition}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warehouse events per second",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(events_processed_total{job=\"consumer\"}[1m]))",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cassandra write errors per minute",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "increase(cassandra_write_errors_total{job=\"consumer\"}[1m])",
          "legendFormat": "write errors"
        }
      ]
    }
  ]
}
