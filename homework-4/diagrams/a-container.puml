@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName SansSerif
skinparam dpi 120
title Вариант 1. PostgreSQL и фоновые обработчики

System_Ext(app, "Приложение банка", "Получает push и подтверждает получение")
System_Ext(bank, "Сервисы банка", "Переводы, платежи, продукты, кампании")
System_Ext(providers, "Провайдеры доставки", "Push: FCM/APNs; SMS; email")

Boundary(platform, "", "") {
  Container(api, "Notification API", "Go, HTTPS/JSON", "Приём, настройки, статусы и подтверждения доставки")
  ContainerDb(db, "Состояние и задания", "PostgreSQL 17; 3 узла", "Sync >= 1 реплики. Уведомления, попытки, настройки; отдельные critical/background задания")
  Container(workers, "Delivery Workers", "Go; отдельные пулы", "Берут задания, выбирают канал, повторяют попытки и выполняют failover")
}

Rel(bank, api, "Запрашивает отправку / статус", "HTTPS")
Rel(app, api, "Настройки и подтверждение push", "HTTPS")
Rel(api, db, "Сохраняет / читает", "SQL")
Rel(workers, db, "Берут задания и меняют состояние", "SQL, SKIP LOCKED")
Rel(workers, providers, "Отправляют уведомления", "HTTPS")
Rel(providers, api, "Сообщают результат SMS/email", "HTTPS callback")

caption Пунктирная рамка — Notification Platform.\nВнешние провайдеры доставляют push в приложение, SMS/email — клиенту.
SHOW_LEGEND()
@enduml
